<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="openlight.astro.probe"
    android:versionCode="1"
    android:versionName="0.1">

    <!-- targetSdk 22 намеренно: на Android 6 разрешения тогда выдаются при установке,
         и пробнику не нужен диалог. Проверяем захват, а не работу с разрешениями. -->
    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="22"/>

    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

    <uses-feature android:name="android.hardware.camera" android:required="true"/>

    <application android:label="Astro Probe" android:hasCode="true">
        <activity android:name=".ProbeActivity"
                  android:label="Astro Probe"
                  android:screenOrientation="landscape"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
